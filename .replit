modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Event Pipeline"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "History Migration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Reprocess Weekends"

[[workflows.workflow]]
name = "Event Pipeline"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "History Migration"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python migrate_history.py"

[[workflows.workflow]]
name = "Reprocess Weekends"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python reprocess_weekends.py --confirm"

[workflows.workflow.metadata]
outputType = "console"

# UI Dashboard — Streamlit on port 8080. Replit's webview previews it
# automatically. Spawns main.py / lookup_post.py / audits as subprocess.
[[workflows.workflow]]
name = "UI Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run ui.py --server.port 8080 --server.address 0.0.0.0"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
