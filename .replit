modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
# The UI Dashboard is the single Replit workflow now. All previous
# workflows (Event Pipeline, History Migration, Reprocess Weekends, and
# the parallel "Project" that fired all three at once with --confirm
# bypasses) are launched from inside the UI instead, where they have
# proper confirms, progress tails, and live state. Consolidating to
# one workflow removes the footgun of accidentally selecting a
# destructive workflow from the dropdown.
runButton = "UI Dashboard"

[[workflows.workflow]]
name = "UI Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run ui.py --server.port 5000 --server.address 0.0.0.0"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
